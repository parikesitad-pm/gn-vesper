# Vesper Notch — environment (optional)
#
# This app runs with no configuration at all: that is Demo Mode, and it is a
# first-class state, not a degraded one. Copy this file to `.env.local` only if
# you want to try the optional AI classifier.
#
#   cp .env.example .env.local
#
# Never commit a real key. `.env*` is already gitignored except this example.
# These values are read on the server only — they are never sent to the browser.

# Pin one provider. Leave unset to let the app prefer Gemini, then any
# OpenAI-compatible key that is present.
# Values: gemini | openai
VESPER_AI_PROVIDER=

# --- Gemini (https://aistudio.google.com/apikey) -----------------------------
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash-lite.
VESPER_GEMINI_MODEL=

# --- OpenAI, or any OpenAI-compatible endpoint ------------------------------
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
VESPER_OPENAI_MODEL=
# Optional. Defaults to https://api.openai.com/v1.
# Point this at Groq, Mistral, a local server, etc. to swap providers.
VESPER_OPENAI_BASE_URL=
