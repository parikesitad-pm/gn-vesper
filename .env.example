# Vesper Notch — environment (optional)
#
# This app runs with no configuration at all: that is Demo Mode, and it is a
# first-class state, not a degraded one. Local rules still run; creator
# questions are answered by quoting the best retrieved public chunk instead of
# calling a model.
#
#   cp .env.example .env.local
#
# Never commit a real key. `.env*` is already gitignored except this example.
# These values are read on the server only — they are never sent to the browser.

# Which provider classifies ACT commands. Creator KNOW answers always prefer
# Gemini, then Groq, regardless of this pin.
# Values: auto (default) | groq | gemini | openai
VESPER_AI_PROVIDER=

# --- Groq (https://console.groq.com/keys) ------------------------------------
# The fast path for intent classification; also the answer fallback.
GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-20b.
VESPER_GROQ_MODEL=

# --- Gemini (https://aistudio.google.com/apikey) -----------------------------
# The primary provider for grounded creator answers; also the classify fallback.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite (verified responsive).
VESPER_GEMINI_MODEL=

# --- OpenAI, or any OpenAI-compatible endpoint -------------------------------
# Optional third provider. Not required for the showcase.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
VESPER_OPENAI_MODEL=
# Optional. Defaults to https://api.openai.com/v1.
VESPER_OPENAI_BASE_URL=
